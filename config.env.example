# Kopier til config.env og juster. config.env er i .gitignore (sjekk aldri inn
# hemmeligheter). Alt her kan også settes som vanlige env-variabler på CLI.

# --- Modell ---
MODEL_ID=philbert440/Qwen3.6-27B-Uncensored-Cyber
TOOL_PARSER=hermes          # Qwen-base -> hermes ; Llama-base -> llama3_json
MAX_MODEL_LEN=32768

# --- Maskinvare ---
TP_SIZE=1                   # antall GPU-er: 1x A100 = 1, 2x A100 = 2
GPU_UTIL=0.90               # andel VRAM vLLM får bruke

# --- Nettverk / auth ---
PORT=8000
# API_KEY=                  # tom = autogenereres ved bootstrap
# HF_TOKEN=                 # valgfri Hugging Face-token for nedlasting
