# Copy to config.env and adjust. config.env is in .gitignore.
# Everything here can also be set as an env var on the CLI (CLI wins).

# --- Model ---
MODEL_ID=philbert440/Qwen3.6-27B-Uncensored-Cyber
TOOL_PARSER=qwen3_coder     # the model above sends Qwen3-Coder format -> qwen3_coder
                            # Qwen2.5/Hermes-JSON -> hermes ; Llama base -> llama3_json
MAX_MODEL_LEN=131072        # 128k via YaRN (LONG_CONTEXT=1). Without YaRN: max 32768.

# --- Long context (YaRN) ---
# Qwen3 is 32768 tokens native. LONG_CONTEXT=1 turns on YaRN scaling up to
# MAX_MODEL_LEN above; serve.sh computes factor = MAX_MODEL_LEN / 32768 itself.
# LONG_CONTEXT=0 (+ MAX_MODEL_LEN<=32768) if you don't need long context —
# YaRN with a fixed factor can slightly weaken short answers.
LONG_CONTEXT=1
# fp8 halves the KV cache so 128k fits on one A100 80GB. 'auto' = off.
# VRAM error at startup? Lower MAX_MODEL_LEN (e.g. 65536) or GPU_UTIL.
KV_CACHE_DTYPE=fp8
# The model is a Mamba hybrid: each concurrent sequence takes one Mamba cache
# block. The vLLM default (256) blows up at long context ("exceeds available
# Mamba cache blocks"). 16 is plenty for one agent; raise it if you run many
# in parallel.
MAX_NUM_SEQS=16

# --- Hardware ---
TP_SIZE=1                   # number of GPUs: 1x A100 80GB = 1, 2x = 2
GPU_UTIL=0.85               # fraction of VRAM vLLM may use (0.85 leaves margin)

# --- Network / auth ---
PORT=8001                  # 8000 is taken by Vast's caddy — use 8001
# API_KEY=                 # empty = autogenerated at bootstrap
# HF_TOKEN=                # optional Hugging Face token for the download

# --- Recon (optional) ---
# NVD_API_KEY=             # raises NVD's rate limit (5 -> 50 calls / 30 s)

# --- Preflight thresholds (rarely need changing) ---
# NEED_VRAM_FREE_GB=70
# NEED_RAM_GB=32
# NEED_DISK_GB=120
