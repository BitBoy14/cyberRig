# Kopier til config.env og juster. config.env er i .gitignore.
# Alt her kan også settes som env-variabel på CLI (CLI vinner).

# --- Modell ---
MODEL_ID=philbert440/Qwen3.6-27B-Uncensored-Cyber
TOOL_PARSER=qwen3_coder     # modellen over sender Qwen3-Coder-format -> qwen3_coder
                            # Qwen2.5/Hermes-JSON -> hermes ; Llama-base -> llama3_json
MAX_MODEL_LEN=131072        # 128k via YaRN (LONG_CONTEXT=1). Uten YaRN: maks 32768.

# --- Lang kontekst (YaRN) ---
# Qwen3 er 32768 tokens native. LONG_CONTEXT=1 slår på YaRN-skalering opp til
# MAX_MODEL_LEN over; serve.sh regner factor = MAX_MODEL_LEN / 32768 selv.
# LONG_CONTEXT=0 (+ MAX_MODEL_LEN<=32768) hvis du ikke trenger lang kontekst —
# YaRN med fast factor kan gi litt svakere korte svar.
LONG_CONTEXT=1
# fp8 halverer KV-cachen så 128k får plass på ett A100 80GB. 'auto' = av.
# VRAM-feil ved oppstart? Senk MAX_MODEL_LEN (f.eks. 65536) eller GPU_UTIL.
KV_CACHE_DTYPE=fp8
# Modellen er Mamba-hybrid: hver samtidige sekvens tar én Mamba-cache-blokk.
# vLLM-default (256) sprenger ved lang kontekst ("exceeds available Mamba cache
# blocks"). 16 holder rikelig for én agent; hev om du kjører mange parallelt.
MAX_NUM_SEQS=16

# --- Maskinvare ---
TP_SIZE=1                   # antall GPU-er: 1x A100 80GB = 1, 2x = 2
GPU_UTIL=0.85               # andel VRAM vLLM får bruke (0.85 gir margin)

# --- Nettverk / auth ---
PORT=8001                  # 8000 er opptatt av Vast sin caddy — bruk 8001
# API_KEY=                 # tom = autogenereres ved bootstrap
# HF_TOKEN=                # valgfri Hugging Face-token for nedlasting

# --- Preflight-terskler (sjelden nødvendig å endre) ---
# NEED_VRAM_FREE_GB=70
# NEED_RAM_GB=32
# NEED_DISK_GB=120
